{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FerrumPulse",
  "version": "0.1.0",
  "identifier": "com.ferrumpulse.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FerrumPulse | Gaming & PC Optimizer",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

